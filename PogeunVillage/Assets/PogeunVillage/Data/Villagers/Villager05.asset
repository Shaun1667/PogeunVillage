  m_Script: {fileID: 11500000, guid: 1151c35772c410c4c9e731e712d3c98a, type: 3}
  m_Name: Villager05
  m_EditorClassIdentifier: PogeunVillage::PogeunVillage.VillagerDefinition
  id: Villager05
  displayName: "\uC8FC\uBBFC 05"
  species: "\uBBF8\uC815"
  bodyColor: {r: 0.7056, g: 0.98, b: 0.81536, a: 1}
  accentColor: {r: 0.41, g: 0.82, b: 0.574, a: 1}
  morningLines:
  - "\uC88B\uC740 \uC544\uCE68! \uC624\uB298\uB3C4 \uD3EC\uADFC\uD55C \uD558\uB8E8\uAC00 \uB420 \uAC83 \uAC19\uC544."
  - "\uC544\uCE68 \uACF5\uAE30\uAC00 \uC0C1\uCF8C\uD558\uB2E4~"
  daytimeLines:
  - "\uC548\uB155! \uC0B0\uCC45\uD558\uAE30 \uB531 \uC88B\uC740 \uB0A0\uC528\uC57C."
  - "\uC5B4\uB514 \uAC00\uB294 \uAE38\uC774\uC57C?"
  eveningLines:
  - "\uBC8C\uC368 \uC800\uB141\uC774\uB124. \uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB560\uC5B4?"
  - "\uB178\uC744\uC774 \uCC38 \uC608\uC058\uB2E4."
  smallTalk:
  - "\uAD11\uC7A5 \uBD84\uC218 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA74 \uB9C8\uC74C\uC774 \uD3B8\uD574\uC838."
  - "\uAC15\uAC00\uC5D0 \uAF43\uC774 \uB9CE\uC774 \uD53C\uC5C8\uB354\uB77C."
  - "\uBB18\uBAA9\uC744 \uC2EC\uC73C\uBA74 \uC5B8\uC820\uAC00 \uD070 \uB098\uBB34\uAC00 \uB41C\uB300."
  - "\uB098\uBB34\uB97C \uD754\uB4E4\uBA74 \uC5F4\uB9E4\uAC00 \uB5A8\uC5B4\uC9C0\uB294 \uAC70 \uC54C\uC544?"
  campLines:
  - "\uC774 \uB9C8\uC744 \uCC38 \uD3EC\uADFC\uD558\uB2E4\u2026 \uBA70\uCE60 \uBA38\uBB3C\uB7EC\uB3C4 \uB420\uAE4C?"
  - "\uCEA0\uD551\uD558\uAE30 \uB531 \uC88B\uC740 \uACF3\uC774\uB124! \uB108\uB294 \uC5EC\uAE30 \uC0B4\uC544?"
  moveInLines:
  - "\uACB0\uC815\uD588\uC5B4! \uB098 \uC774 \uB9C8\uC744\uC5D0 \uC774\uC0AC \uC62C\uAC8C!"
  movingLines:
  - "\uB0B4\uC77C \uC774\uC0AC \uAC08\uAC8C! \uC798 \uBD80\uD0C1\uD574."
  - "\uC5B4\uB5A4 \uC9D1\uC744 \uC9C0\uC744\uC9C0 \uBC8C\uC368 \uC124\uB808~"
  leavingLines:
  - "\u2026\uC694\uC998 \uC774 \uB9C8\uC744\uC744 \uB5A0\uB0A0\uAE4C \uC0DD\uAC01 \uC911\uC774\uC57C."
  - "\uC9D0\uC744 \uC2F8\uACE0 \uC788\uC5C8\uC5B4. \uBCC4\uC77C \uC5C6\uC73C\uBA74 \uB0B4\uC77C \uB5A0\uB0A0 \uAC70\uC57C."
  requestLines:
  - "\uBD80\uD0C1\uC774 \uC788\uB294\uB370\u2026 {0} {1}\uAC1C\uB9CC \uAC00\uC838\uB2E4\uC904 \uC218 \uC788\uC5B4?"
  - "{0} {1}\uAC1C\uAC00 \uAF2D \uD544\uC694\uD574! \uAD6C\uD574 \uC904\uB798?"
  requestThanksLines:
  - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC! \uC774\uAC74 \uC791\uC740 \uB2F5\uB840\uC57C."
  - "\uC640, \uB531 \uD544\uC694\uD588\uC5B4! \uACE0\uB9C8\uC6CC, \uC774\uAC70 \uBC1B\uC544."
  thanksLines:
  - "\uC640, \uACE0\uB9C8\uC6CC! \uC18C\uC911\uD788 \uAC04\uC9C1\uD560\uAC8C."
  - "\uB098\uD55C\uD14C \uC8FC\uB294 \uAC70\uC57C? \uC815\uB9D0 \uAE30\uBED0!"
